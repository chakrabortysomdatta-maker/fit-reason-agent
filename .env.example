# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Settings > Database > Connection string (URI, session pooler). Used only to create tables.
SUPABASE_DB_URL=
# Demo login passwords (created by scripts/create_users.py)
NEHA_PASSWORD=
CHHAYA_PASSWORD=
# Rupees per US dollar, used for the cost meter
INR_PER_USD=88

# Model provider: groq (default) or openrouter
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Cheap model for bulk tagging and checks; strong model for second looks and reply drafts
FAST_MODEL=openai/gpt-oss-20b
STRONG_MODEL=openai/gpt-oss-120b
